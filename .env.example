# Stellar Wrap Environment Variables
# Copy this file to .env.local and fill in your values

# Contract Addresses (Soroban format: 56 chars starting with C)
# At least one contract address must be set
NEXT_PUBLIC_CONTRACT_ADDRESS_MAINNET=
NEXT_PUBLIC_CONTRACT_ADDRESS_TESTNET=

# Legacy contract address (used for both networks if above are not set)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# WalletConnect (optional)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Soroban RPC endpoints (optional - defaults provided)
NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=https://soroban-rpc.mainnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=https://soroban-rpc.testnet.stellar.org
